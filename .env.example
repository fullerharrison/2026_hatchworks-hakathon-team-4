# Copy to .env beside Start-Dashboard.cmd. Fill in your own values for AI features.
# Keep the completed .env private; it is excluded from Git and handoff packages.
PORTKEY_API_KEY=
# Use a model route accessible to your token, such as @provider-slug/model-id.
UC4_LLM_MODEL=

# Optional gateway routing. Leave blank unless your configuration requires it.
UC4_LLM_BASE_URL=
PORTKEY_VIRTUAL_KEY=
PORTKEY_CONFIG=
PORTKEY_PROVIDER=
UC4_LLM_PROVIDER_KEY=

# Optional runtime overrides. Uncomment and set a real path when needed.
# UC4_ZIP=get_started/candidate_recommendations_synthetic.zip
# UC4_CANDIDATE_DB=app/data/candidate_history.sqlite3
# UC4_DECISION_LOG=app/data/decisions.jsonl
