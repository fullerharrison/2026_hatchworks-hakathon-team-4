# Copy this file to .env beside Start-Dashboard.cmd, then fill in your own values.
# Required for Ask/chat only. Do not share your completed .env or commit it to Git.
PORTKEY_API_KEY=
# Use a model route that your Portkey token can access, e.g. @provider-slug/model-id.
UC4_LLM_MODEL=

# Optional: defaults to https://api.portkey.ai/v1 when blank.
UC4_LLM_BASE_URL=
# Optional routing values: only fill these if your Portkey setup requires them.
PORTKEY_VIRTUAL_KEY=
PORTKEY_CONFIG=
PORTKEY_PROVIDER=
UC4_LLM_PROVIDER_KEY=
